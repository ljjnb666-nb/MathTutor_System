# Copy to .env and fill values locally. Never commit .env or real secrets.

SECRET_KEY=your-random-secret-key
DATABASE_URL=
CORS_ORIGINS=
ENV=production
DEBUG=0

# Production LLM configuration. The server owns model credentials by default.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
ALLOW_CLIENT_LLM_CONFIG=false

# Local development only:
# Frontend: VITE_ALLOW_CLIENT_LLM_CONFIG=true
# Backend:  ALLOW_CLIENT_LLM_CONFIG=true
# Both switches must be true, and the frontend must be a dev build, before
# browser-stored x-llm-* headers are accepted.

LLM_HTTPS_PROXY=
LLM_HTTP_PROXY=
AI_REQUEST_TIMEOUT=120

# RAG / embedding fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_EMBED_MODEL=deepseek-embedding-v2
RAG_TOP_K=3

# Alipay optional settings.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_DEBUG=0
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# WeChat Pay optional settings.
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_PRIVATE_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_APIV3_KEY=
WECHAT_NOTIFY_URL=
WECHAT_CERT_DIR=
