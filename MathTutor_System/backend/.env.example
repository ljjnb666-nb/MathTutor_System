# 复制为 .env 后按需填写，勿提交 .env 到版本库

# 生产必填：JWT 签名密钥，勿使用默认值
SECRET_KEY=your-random-secret-key

# 数据库（可选，默认 SQLite：backend/math_tutor.db）
# DATABASE_URL=sqlite:///./math_tutor.db

# 生产必填：前端访问地址，逗号分隔，避免 CORS 预检失败
# 例：通过 https://你的域名 访问时填 CORS_ORIGINS=https://你的域名
# 例：通过 IP 访问时填 CORS_ORIGINS=http://公网IP
# CORS_ORIGINS=

# LLM 智能出题（可选，也可在前端「设置」中配置）
# LLM_API_KEY=
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_VERSION=
# LLM_MODEL=deepseek-chat
# 是否允许浏览器通过 x-llm-* 请求头临时提供 API Key。
# 开发环境默认允许；生产环境默认禁用，若要使用前端本地 Key 模式需显式开启。
# ALLOW_CLIENT_LLM_CONFIG=true

# 本地知识库 RAG：优先用 DeepSeek 做向量化（与出题共用 Key 即可）
# 配置 DEEPSEEK_API_KEY 或 LLM_PROVIDER=deepseek + LLM_API_KEY 后，上传/检索知识库即用 DeepSeek Embedding
# DEEPSEEK_EMBED_MODEL=deepseek-embedding-v2
# RAG 检索条数（出题/组卷/对话时取几条知识库上下文），默认 3，范围 1–15
# RAG_TOP_K=3

# 环境标识（可选）：设为 production 时若未设置 SECRET_KEY 会打警告
# ENV=production
# DEBUG=0

# ---------- 支付宝支付（可选，不配置则显示「支付即将上线」） ----------
# 沙箱：https://openhome.alipay.com/platform/appDaily.htm
# ALIPAY_APP_ID=沙箱APPID
# ALIPAY_PRIVATE_KEY=应用私钥内容（PEM，可用换行；或填文件路径如 file:keys/app_private_key.pem）
# ALIPAY_PUBLIC_KEY=支付宝公钥（沙箱公钥或正式公钥；或 file:keys/alipay_public_key.pem）
# ALIPAY_DEBUG=1   # 1=沙箱，0=正式
# 异步回调需公网可访问（可用 Cpolar/Ngrok 穿透）：ALIPAY_NOTIFY_URL=https://你的域名/api/payment/notify/alipay
# 支付完成跳转（可选）：ALIPAY_RETURN_URL=https://你的域名/pricing?paid=1

# ---------- 微信支付 Native 扫码（可选） ----------
# 商户平台：https://pay.weixin.qq.com/  申请 Native 支付、获取证书与 APIv3 密钥
# WECHAT_APPID=应用ID
# WECHAT_MCHID=商户号
# WECHAT_PRIVATE_KEY=商户API证书私钥 PEM 内容（或 file:path/to/apiclient_key.pem）
# WECHAT_CERT_SERIAL_NO=商户API证书序列号
# WECHAT_APIV3_KEY=APIv3 密钥（32 位）
# 异步回调需公网：WECHAT_NOTIFY_URL=https://你的域名/api/payment/notify/wechat
# WECHAT_CERT_DIR= 可选，平台证书缓存目录，不填则自动管理
